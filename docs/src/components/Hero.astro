---
import Default from '@astrojs/starlight/components/Hero.astro';

const data = Astro.locals.starlightRoute?.entry?.data as
	| { nxHome?: boolean }
	| undefined;
const isHome = data?.nxHome;
---

{
	/* The custom homepage renders its own hero; the marker lets the theme drop Starlight's width limits. */
}
{isHome ? <span data-nx-home-marker hidden /> : <Default {...Astro.props} />}
